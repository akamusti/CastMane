__pycache__/
*.pyc
.venv/
.venv-appimage/
venv/
*.egg-info/
dist/
build/
AppDir/
*.AppImage
# crash-safe recordings: partial chunks are kept locally, only final .mp4 matters
*.part
Videos/
# node / website (Astro Starlight)
node_modules/
website/node_modules/
website/dist/
website/.astro/
npm-debug.log*
# secrets / local env
# CastMane ships no credentials; .env* stays ignored as a safety net in case
# a local token is ever added. .env.example stays tracked on purpose.
.env
.env.*
!.env.example
